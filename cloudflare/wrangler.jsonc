{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "promise-continuity",
  "main": "./worker.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "promise-continuity.nxsio.com", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "promise-continuity",
    "database_id": "f8555f75-b011-4fb7-9760-3208f16a6651",
    "migrations_dir": "./migrations"
  }],
  "vars": {
    "PROMISE_MODEL_PROVIDER": "deepinfra",
    "DAILY_MODEL_LIMIT": "100",
    "VISITOR_DAILY_MODEL_LIMIT": "3"
  }
}
